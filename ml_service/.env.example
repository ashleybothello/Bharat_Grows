# Crop Decision Engine weights — read by ml_service/decision_engine.py.
#
# These are PROJECT-DEFINED scoring values, not derived from an agronomic study.
# They are renormalised automatically when a component is unavailable (for
# example, when no candidate crop has a published mandi price).
#
# Leave unset to use the defaults shown here.
DECISION_WEIGHT_CROP=0.60
DECISION_WEIGHT_MARKET=0.25
DECISION_WEIGHT_WATER=0.15
