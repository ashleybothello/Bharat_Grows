PORT=5005
HOST=0.0.0.0
FRONTEND_URL=http://localhost:5173
AUTH_MODE=production
OTP_PROVIDER=fast2sms
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_HASH_SECRET=
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
FAST2SMS_TEMPLATE_ID=
FAST2SMS_SENDER_ID=
FAST2SMS_ROUTE=q
DATABASE_URL=
JWT_SECRET=
SESSION_SECRET=
DATA_GOV_API_KEY=
MARKET_CACHE_TTL_MS=1200000
MARKET_LIVE_HISTORY_DAYS=14
MARKET_BACKFILL_DAYS=30
MARKET_SYNC_GAP_MS=280

# Python ML service. Local: http://127.0.0.1:8000
# Production: https://<ml-service>.onrender.com
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=20000

# Simulated IoT sensor engine (software, not ESP32). Hardware remains /beta.
SIM_ENABLED=true
SIM_INTERVAL_MS=10000
SIM_MAX_NODES=12
SIM_SPONTANEOUS_ANOMALIES=true
SIM_ANOMALY_CHANCE=0.01

# Live ESP32 gateway (Hardware Beta). Saved in esp_telemetry, not sensor_telemetry.
ESP_GATEWAY_URL=
ESP_POLL_MS=5000

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=
ALERT_TO_EMAIL=
ALERT_TIMEZONE=Asia/Kolkata

GEMINI_API_KEY=

# Kindwise plant.id (leaf / plant health). Server-side only.
PLANT_ID_API_KEY=
PLANT_HEALTH_API_KEY=
PLANT_ID_API_URL=
PLANT_HEALTH_API_URL=

# Kindwise insect.id. Server-side only.
INSECT_ID_API_KEY=
INSECT_ID_API_URL=
