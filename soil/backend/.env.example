PORT=5005
AUTH_MODE=production
OTP_PROVIDER=fast2sms
OTP_EXPIRY_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
FAST2SMS_API_KEY=
FAST2SMS_OTP_ID=
FAST2SMS_TEMPLATE_ID=
FAST2SMS_SENDER_ID=
FAST2SMS_ROUTE=q
DATABASE_URL=
JWT_SECRET=
# Optional. If unset, a secret is stored in soil/backend/.data/ so logins survive server restarts.
SESSION_SECRET=
DATA_GOV_API_KEY=
MARKET_CACHE_TTL_MS=1200000
MARKET_LIVE_HISTORY_DAYS=14
MARKET_BACKFILL_DAYS=30
MARKET_SYNC_GAP_MS=280

# Python ML service (crop model + rainfall intelligence + decision engine).
# Server-side only: React never receives this URL and never loads model files.
# Decision engine weights live in the Python process — see ml_service/.env.example.
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=20000

# Simulated IoT sensor engine (software, not ESP32). Hardware remains /beta.
SIM_ENABLED=true
SIM_INTERVAL_MS=10000
SIM_MAX_NODES=12
SIM_SPONTANEOUS_ANOMALIES=true
SIM_ANOMALY_CHANCE=0.01

# Live ESP32 gateway (Hardware Beta). Saved in esp_telemetry, not sensor_telemetry.
# Do not point this at the local ML service — it is a separate FastAPI on the ESP LAN.
ESP_GATEWAY_URL=http://10.111.226.121:8000/api/sensor-data
ESP_POLL_MS=5000

# Critical alerts — email (Nodemailer). Never put these in Vite.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=
# Used only when the farmer profile has no email.
ALERT_TO_EMAIL=
ALERT_TIMEZONE=Asia/Kolkata

# Optional. Used by the Express /api/chat Gemini fallback. Never put this in Vite.
GEMINI_API_KEY=


# Create a free key at https://data.gov.in (login → Generate API Key).
# Used only by soil/backend to fetch AGMARKNET mandi prices. Never put this in Vite.

# OTP_PROVIDER=fast2sms is the default and sends a real SMS.
# OTP_PROVIDER=mock is development-only and must be set explicitly.
# Never leave OTP_PROVIDER unset if you want to be sure of the mode.
